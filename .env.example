# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon (publishable) key. Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_ and never commit a real value.
# Bypasses RLS: used for username registration, admin features and team mutations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# SERVER-ONLY. Random string of 32+ characters used to derive invitation tokens.
# Generate one with:  openssl rand -base64 48
# Changing it invalidates every existing invitation link.
INVITE_TOKEN_SECRET=

# Public base URL used to build invitation links (no trailing slash).
# Optional: falls back to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used ONLY by `npm run admin:bootstrap` to create the first administrator.
# The password must be changed at first login. Remove these after bootstrapping.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
